# Copy this file to .env and fill in the values you need:
#   cp .env.example .env
#
# Nothing here is required to start the server. By default, users supply
# their own model API key from the frontend on each request. These variables
# only matter if you want the backend itself to hold keys/config (e.g. for
# local development or curl testing without a frontend).

# --- Server ---
# Port the app listens on (Cloud Run sets this automatically).
PORT=8080
# "development" enables uvicorn --reload; anything else behaves as production.
ENVIRONMENT=production

# --- Model provider keys (optional) ---
# Only needed if GET_API_KEYS_FROM_CONFIG=true and you want the backend to
# fall back to environment-provided keys instead of the request's api_key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# For Kimi K2 (Moonshot AI), which is used via the Anthropic-compatible API:
# set ANTHROPIC_API_KEY to your Moonshot key and point the base URL at Moonshot.
# ANTHROPIC_BASE_URL=https://api.moonshot.ai/anthropic
MOONSHOT_API_KEY=

# Enables the legacy env/config-based API key lookup path described in
# open_deep_research/utils.py. Not needed for normal operation, where the
# frontend passes the user's API key directly on each request.
GET_API_KEYS_FROM_CONFIG=false

# --- Search ---
# Required only if search_api is set to "tavily" in open_deep_research/configuration.py
# (the app currently defaults research requests to Anthropic's native web search).
TAVILY_API_KEY=

# --- Supabase (optional persistence) ---
# If unset, research history/metrics are kept in memory only and lost on restart.
SUPABASE_URL=
SUPABASE_ANON_KEY=
